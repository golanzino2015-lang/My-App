<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:colorControlActivated">@color/white</item>
        <item name="android:colorControlNormal">@color/faint</item>
        <item name="android:textColorHighlight">#55FFFFFF</item>
    </style>

    <!-- Full-screen transparent window; the activity draws its own scrim and sheet. -->
    <style name="OverlayTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="SheetDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:colorControlActivated">@color/white</item>
        <item name="android:colorControlNormal">@color/faint</item>
        <item name="android:textColorHighlight">#55FFFFFF</item>
    </style>
</resources>
